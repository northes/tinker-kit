<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="TinkerKit"
        Arguments=""
        InstallLocation="C:\Program Files\TinkerKit\TinkerKit">
    </Installer>
    <PackageInformation
        PackageName="TinkerKit"
        PackageDisplayName="TinkerKit"
        PublisherName="CN=TinkerKit"
        PublisherDisplayName="TinkerKit"
        Version="0.1.0.0"
        PackageDescription="TinkerKit developer utility application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.tinkerkit.app"
                Description="TinkerKit developer utility application"
                DisplayName="TinkerKit"
                ExecutableName="TinkerKit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TinkerKit</DisplayName>
            <PublisherDisplayName>TinkerKit</PublisherDisplayName>
            <Description>TinkerKit developer utility application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="TinkerKit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
